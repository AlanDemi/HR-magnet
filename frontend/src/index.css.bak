@import "tailwindcss";

/* ── Custom Telegram Mini App Theme ─────────────────────────── */

:root {
  --bg-primary: #141414;
  --text-primary: #EAF4FE;
  --accent-blue: #4C51C6;
  --accent-orange: #FE830C;
  --surface-card: #1E1E1E;

  --tg-theme-bg-color: var(--bg-primary);
  --tg-theme-text-color: var(--text-primary);
  --tg-theme-hint-color: #8b8b9e;
  --tg-theme-link-color: var(--accent-blue);
  --tg-theme-button-color: var(--accent-blue);
  --tg-theme-button-text-color: #ffffff;
  --tg-theme-secondary-bg-color: var(--surface-card);

  --accent: var(--accent-blue);
  --accent-light: #6d72e5;
  --success: #00cec9;
  --glass-bg: rgba(30, 30, 30, 0.85);
  --glass-border: rgba(255, 255, 255, 0.08);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  width: 100%;
  background-color: var(--bg-primary);
}

body {
  font-family: 'Onest', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  background: radial-gradient(circle at top right, rgba(76, 81, 198, 0.08), transparent 50%),
    radial-gradient(circle at bottom left, rgba(254, 131, 12, 0.04), transparent 50%),
    var(--bg-primary);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ── Glass card ──────────────────────────────────────────────── */
.glass {
  background: var(--glass-bg);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid var(--glass-border);
  border-radius: 20px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

/* ── Buttons ─────────────────────────────────────────────────── */
.btn-primary {
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
  color: #fff;
  border: none;
  border-radius: 14px;
  padding: 14px 28px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.2s;
  width: 100%;
  text-align: center;
}

.btn-primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 8px 25px rgba(76, 81, 198, 0.35);
}

.btn-primary:active {
  transform: translateY(0);
}

.btn-primary:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}

.btn-secondary {
  background: rgba(255, 255, 255, 0.04);
  color: var(--accent-light);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  padding: 12px 24px;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s, border-color 0.2s;
  width: 100%;
  text-align: center;
}

.btn-secondary:hover {
  background: rgba(76, 81, 198, 0.12);
  border-color: rgba(76, 81, 198, 0.3);
}

/* ── Input fields ────────────────────────────────────────────── */
.input-field {
  width: 100%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 14px;
  padding: 14px 18px;
  font-size: 16px;
  color: var(--text-primary);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  font-family: inherit;
}

.input-field::placeholder {
  color: var(--tg-theme-hint-color);
}

.input-field:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px rgba(76, 81, 198, 0.15);
}

/* ── Select dropdown ─────────────────────────────────────────── */
select.input-field {
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  padding-right: 42px;
  cursor: pointer;
  background-color: rgba(255, 255, 255, 0.05);
  color: var(--text-primary);
}

select.input-field option {
  background: #1e1e1e;
  color: var(--text-primary);
  padding: 8px;
}

/* ── Skills tag chips ────────────────────────────────────────── */
.skill-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(76, 81, 198, 0.1);
  border: 1px solid rgba(76, 81, 198, 0.3);
  border-radius: 12px;
  padding: 8px 16px;
  font-size: 14px;
  font-weight: 500;
  color: #a29bfe;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.skill-chip:hover {
  background: rgba(76, 81, 198, 0.2);
  border-color: #a29bfe;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(76, 81, 198, 0.2);
}

.skill-chip.selected {
  background: var(--accent-blue);
  color: #fff;
  border-color: var(--accent-blue);
  box-shadow: 0 4px 15px rgba(76, 81, 198, 0.4);
}

/* Теги в результатах (Badge style) */
.tag-badge {
  display: inline-flex;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  padding: 3px 10px;
  border-radius: 8px;
  background: rgba(0, 206, 201, 0.1);
  border: 1px solid rgba(0, 206, 201, 0.3);
  color: #00cec9;
}

/* ── Animations ──────────────────────────────────────────────── */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes pulse-glow {

  0%,
  100% {
    box-shadow: 0 0 20px rgba(76, 81, 198, 0.3);
  }

  50% {
    box-shadow: 0 0 40px rgba(76, 81, 198, 0.6);
  }
}

@keyframes spin-slow {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

@keyframes float {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8px);
  }
}

.animate-fade-in-up {
  animation: fadeInUp 0.5s ease-out forwards;
}

.animate-pulse-glow {
  animation: pulse-glow 2s ease-in-out infinite;
}

.animate-spin-slow {
  animation: spin-slow 3s linear infinite;
}

.animate-float {
  animation: float 3s ease-in-out infinite;
}

/* ── Progress bar ────────────────────────────────────────────── */
.progress-bar {
  height: 4px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2px;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), var(--success));
  border-radius: 2px;
  transition: width 0.4s ease;
}

/* ── Match bar ───────────────────────────────────────────────── */
.match-bar {
  height: 8px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 4px;
  overflow: hidden;
  flex: 1;
}

.match-bar-fill {
  height: 100%;
  border-radius: 4px;
  transition: width 0.6s ease;
}

/* ── Custom scrollbar ────────────────────────────────────────── */
.custom-scrollbar::-webkit-scrollbar {
  width: 4px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: transparent;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}

/* ── Admin Dashboard ─────────────────────────────────────────── */
.admin-container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px 32px;
  min-height: 100vh;
}

@media (max-width: 768px) {
  .admin-container {
    padding: 16px;
  }
}

/* ── Select dropdown styling ─────────────────────────────────── */
select {
  color: var(--text-primary);
  background-color: var(--surface-card);
}

select option {
  background-color: var(--surface-card);
  color: var(--text-primary);
}